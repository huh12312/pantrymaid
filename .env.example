# Database
POSTGRES_DB=pantrymaid
POSTGRES_USER=pantrymaid
POSTGRES_PASSWORD=changeme_secure_password_here
# For production, add ?sslmode=require to enable encrypted connections
DATABASE_URL=postgresql://pantrymaid:changeme_secure_password_here@postgres:5432/pantrymaid

# Auth
# Generate with: openssl rand -base64 32
# IMPORTANT: Must be at least 32 characters for security
BETTER_AUTH_SECRET=changeme_random_32_byte_base64_secret_EXAMPLE_vJ8fK2mN9pQ3rS5tU7vW9yZ1aB3cD5eF
BETTER_AUTH_URL=http://localhost:3000

# Meal planning — key-encryption-key (KEK) for household-supplied LLM API keys
# Generate with: openssl rand -base64 32
#
# THE #1 MISTAKE: that command's output is a 44-CHARACTER base64 string which decodes
# to exactly 32 BYTES — that is what MEAL_PLAN_KEK must be. Do NOT hand-type or
# construct a "32 byte key" by pasting a 32-CHARACTER string instead (e.g. a random
# password generator's "32 chars" output) — that decodes to only 24 bytes and fails.
# Always run the command above and paste its FULL, UNMODIFIED output — don't
# truncate it, don't reformat it. If you're unsure which one you have, count the
# characters: 44 is right, 32 is the classic mistake.
#
# MUST decode to exactly 32 bytes and MUST be DISTINCT from BETTER_AUTH_SECRET —
# rotating one must not invalidate the other. There is no plaintext fallback: the
# server refuses to save or read API keys if this is absent or the wrong length, and
# logs a loud, unmissable warning at boot (not just on first save) if it's set but the
# wrong length — check the server log if per-household AI keys won't save.
# LOSING THIS KEY MEANS LOSING EVERY STORED API KEY — every household will need to
# re-enter theirs. Back it up like any other production secret.
MEAL_PLAN_KEK=changeme_random_32_byte_base64_key_EXAMPLE_aB1cD2eF3gH4iJ5kL6mN7oP8q
# Set only while rotating MEAL_PLAN_KEK: put the OLD key here after generating a new
# MEAL_PLAN_KEK. Used for decrypt-only fallback until every row has been re-saved
# under the new key, then remove it.
# MEAL_PLAN_KEK_PREVIOUS=

# LLM provider — one of: openai, anthropic, groq, ollama (default: openai). Used for
# receipt parsing / expiry estimation regardless of value.
#
# This also doubles as the CONTAINER-WIDE DEFAULT provider for meal planning
# (docs/plans/meal-planning.md §4.5): if a household hasn't picked its own
# provider/model in Settings, meal-plan generation falls back to LLM_PROVIDER /
# LLM_MODEL + the matching *_API_KEY below. IMPORTANT: meal planning supports only
# THREE providers — openai, anthropic, openrouter. Setting this to groq or ollama is
# completely fine for receipt parsing, but means meal planning has no container-wide
# default; the Settings UI will say so rather than silently rendering an empty form.
LLM_PROVIDER=openai
# Override the default model for the selected provider (optional)
# Defaults: openai=gpt-4o-mini, anthropic=claude-haiku-4-5-20251001, groq=llama-3.1-8b-instant, ollama=llama3.2
# LLM_MODEL=gpt-4o-mini
# Vision model used for receipt image parsing (requires vision capability)
# Defaults: openai=gpt-5.4-mini, anthropic=claude-sonnet-4-6
# Only openai and anthropic providers support vision
# LLM_VISION_MODEL=gpt-5.4-mini

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (required when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# OpenRouter — meal planning only (receipt parsing / getModel() does not support this
# provider). Lets the operator supply ONE container-wide OpenRouter key that every
# household without its own key falls back to; set LLM_PROVIDER=openrouter and
# LLM_MODEL to an OpenRouter model id (e.g. "openai/gpt-4o-mini") to use it as the
# default.
# OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Groq (required when LLM_PROVIDER=groq)
# Free tier at https://console.groq.com
# GROQ_API_KEY=gsk_your-groq-key-here

# Ollama (required when LLM_PROVIDER=ollama — no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Meal planning: household BYO-key vs. the container-wide keys above ---
# Every household can also save its OWN provider/model/API key in Settings — a
# household key ALWAYS wins over the keys above when one is stored, and is required
# either way for MEAL_PLAN_KEK to have anything to encrypt (see below). The env keys
# above exist purely as an operator-supplied default for households that never save
# their own: resolution order is household key -> matching env key for the household's
# provider -> generation fails with "no API key configured". The env key is never
# written into the database and is never exposed to households in the Settings UI
# (they only ever see their OWN key's last 4 characters, never the operator's).
#
# MEAL_PLAN_KEK below is still required even if you only ever use the container-wide
# keys — saving OR decrypting a per-household key fails (500) without it, so it must
# be set for the per-household override path to work at all.

# Pexels (image fallback for items not in Open Food Facts or Wikipedia seed)
# Free at https://www.pexels.com/api/ — 200 req/hour, 20k req/month
PEXELS_API_KEY=your_pexels_api_key_here

# Kroger Public API (https://developer.kroger.com)
# Required for primary grocery product lookup (Kroger → Open Food Facts fallback chain)
# Covers all Kroger-family banners: Kroger, Harris Teeter (chain=HART), Fred Meyer, Ralphs, etc.
# Store-specific pricing and stock require a locationId saved in the household settings.
# Users configure their store via Settings → Store Setup (zip code → store picker).
KROGER_CLIENT_ID=your_kroger_client_id
KROGER_CLIENT_SECRET=your_kroger_client_secret

# Feature flags
# Set to "false" to disable new user registration (existing users can still log in)
SIGNUP_ENABLED=true

# Server
PORT=3000
NODE_ENV=production

# Caddy
DOMAIN=localhost
SSL_MODE=internal
